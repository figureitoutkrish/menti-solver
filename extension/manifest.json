{
  "manifest_version": 3,
  "name": "Menti Solver",
  "version": "2.0.1",
  "description": "Reads Mentimeter quiz questions from the page, asks a fast LLM (Groq / Cerebras) and clicks the answer.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://api.cerebras.ai/*",
    "https://www.menti.com/*",
    "https://menti.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.menti.com/*",
        "https://menti.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Menti Solver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "toggle-solver": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Turn Menti Solver on or off"
    }
  }
}
