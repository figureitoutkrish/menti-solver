# Copy this file to .env (same folder) and fill in your keys.

# Required unless you use Cerebras - https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional backup, raced against Groq - https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Models (gpt-oss-20b is fastest, openai/gpt-oss-120b is more accurate)
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_MODEL=gpt-oss-120b

# Seconds before a provider is treated as failed
TIMEOUT_SECONDS=2.5

# false = only show answers, don't click
AUTO_CLICK=true

# Browser to open: chrome, msedge, or empty for Playwright's bundled Chromium
BROWSER_CHANNEL=chrome

START_URL=https://www.menti.com
